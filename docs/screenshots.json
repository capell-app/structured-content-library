{
    "package": "structured-content-library",
    "composerName": "capell-app/structured-content-library",
    "generatedFor": "deployment-screenshot-runner",
    "requiresInstalledPackage": true,
    "outputDirectory": "packages/structured-content-library/docs/screenshots",
    "fixtureCommands": ["capell:structured-content-library-screenshot-fixture"],
    "composerRequires": [
        "capell-app/structured-content-library",
        "capell-app/content-sections",
        "capell-app/theme-foundation"
    ],
    "entries": [
        {
            "id": "structured-content-list",
            "title": "Structured content item list.",
            "package": "structured-content-library",
            "surface": "admin",
            "targetType": "admin-resource",
            "target": "StructuredContentItemResource",
            "scenario": "admin-index",
            "url": "/structured-content-library/structured-content-items",
            "waitFor": ".fi-ta tbody tr:has-text(\"A clearer editorial workflow\")",
            "required": true,
            "notes": "Capture the item table with type/status badges, reusable content records, and admin actions.",
            "useCase": "An administrator reviews typed reusable content records before themes render them.",
            "screenshotPath": "packages/structured-content-library/docs/screenshots/structured-content-list.png"
        },
        {
            "id": "structured-content-form",
            "title": "Structured content create form.",
            "package": "structured-content-library",
            "surface": "admin",
            "targetType": "admin-resource",
            "target": "StructuredContentItemResource.Create",
            "scenario": "admin-form",
            "url": "/structured-content-library/structured-content-items/create",
            "waitFor": "form",
            "required": true,
            "notes": "Capture a create form showing type, status, portable summary/content, and typed payload fields.",
            "useCase": "An administrator creates reusable content without storing designed page markup.",
            "screenshotPath": "packages/structured-content-library/docs/screenshots/structured-content-form.png"
        },
        {
            "id": "structured-content-theme-rendering",
            "colorSchemes": ["light"],
            "title": "Structured content reusable item edit form.",
            "package": "structured-content-library",
            "surface": "admin",
            "targetType": "admin-resource",
            "target": "StructuredContentItemResource.Edit",
            "scenario": "admin-form",
            "url": "/structured-content-library/structured-content-items/{first-record}/edit",
            "waitFor": "form",
            "required": true,
            "notes": "Capture a published reusable content record with portable body copy and typed public-adapter payload fields.",
            "useCase": "An administrator verifies the content record that themes consume through the package public adapter.",
            "screenshotPath": "packages/structured-content-library/docs/screenshots/structured-content-theme-rendering.png"
        },
        {
            "id": "structured-content-testimonial-public",
            "title": "Structured content testimonial public render.",
            "package": "structured-content-library",
            "surface": "frontend",
            "targetType": "frontend-page",
            "target": "StructuredContentPublicAdapter",
            "scenario": "frontend-page",
            "url": "/screenshot-fixtures/regular/structured-content-testimonial",
            "waitFor": "#screenshot-fixture",
            "colorSchemes": ["light"],
            "required": false,
            "notes": "Capture a theme-backed testimonial or case-study render once the fixture route can render package content through a public adapter.",
            "useCase": "A visitor sees reusable structured content rendered by a theme without database markup leaking into content fields.",
            "screenshotPath": "packages/structured-content-library/docs/screenshots/structured-content-testimonial-public.png"
        },
        {
            "id": "structured-content-type-variation",
            "title": "Structured content type variation.",
            "package": "structured-content-library",
            "surface": "admin",
            "targetType": "admin-resource-record",
            "target": "StructuredContentItemResource.Edit",
            "scenario": "admin-index",
            "url": "/screenshot-fixtures/structured-content-library/team-member",
            "waitFor": "input[id$=\".title\"]",
            "colorSchemes": ["light"],
            "required": false,
            "notes": "Capture the real installed Filament surface after the manifest fixture commands prepare its data and widget settings.",
            "useCase": "An administrator edits a different structured content type with its own typed payload fields.",
            "screenshotPath": "packages/structured-content-library/docs/screenshots/structured-content-type-variation.png"
        },
        {
            "id": "structured-content-empty-state",
            "title": "Structured content empty state.",
            "package": "structured-content-library",
            "surface": "admin",
            "targetType": "admin-resource",
            "target": "StructuredContentItemResource",
            "scenario": "admin-index",
            "url": "/structured-content-library/structured-content-items",
            "waitFor": ".fi-ta-empty-state",
            "required": false,
            "notes": "In the disposable fixture database only, refuse foreign content, soft-delete the six owned fixture rows, capture the real empty table and restore the deterministic populated fixture after each colour scheme.",
            "useCase": "A new site owner understands how to start building a reusable content library.",
            "screenshotPath": "packages/structured-content-library/docs/screenshots/structured-content-empty-state.png",
            "entryState": {
                "state": "empty",
                "tokenPlaceholder": "{attempt-token}",
                "setup": {
                    "command": "capell:structured-content-library-screenshot-fixture",
                    "args": ["--force", "--empty"]
                },
                "restore": {
                    "command": "capell:structured-content-library-screenshot-fixture",
                    "args": ["--force"]
                }
            }
        },
        {
            "id": "structured-content-library-admin-sidebar-menu-open",
            "title": "Structured content item list with admin sidebar menu open.",
            "package": "structured-content-library",
            "surface": "admin",
            "targetType": "admin-resource",
            "target": "StructuredContentItemResource",
            "scenario": "admin-index",
            "url": "/structured-content-library/structured-content-items",
            "waitFor": "table",
            "required": false,
            "notes": "Capture the item table with type/status badges, reusable content records, and admin actions. Capture this same admin surface with the fully collapsible sidebar opened.",
            "useCase": "An administrator reviews typed reusable content records before themes render them.",
            "screenshotPath": "packages/structured-content-library/docs/screenshots/structured-content-library-admin-sidebar-menu-open.png",
            "beforeWait": [
                {
                    "type": "click",
                    "selector": ".fi-topbar-open-collapse-sidebar-btn"
                },
                {
                    "type": "waitFor",
                    "selector": ".fi-sidebar.fi-sidebar-open"
                }
            ]
        }
    ]
}
