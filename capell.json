{
    "manifest-version": 3,
    "name": "capell-app/structured-content-library",
    "slug": "structured-content-library",
    "displayName": "Structured Content Library",
    "kind": "package",
    "capellApiVersion": "^1.0",
    "version": "1.0.0",
    "description": "A single admin home for repeatable business content such as testimonials, FAQs, team members and locations, published by date.",
    "product": {
        "group": "Capell Essentials",
        "tier": "free",
        "bundle": "foundation"
    },
    "namespace": "Capell\\StructuredContentLibrary",
    "surfaces": ["admin", "shared"],
    "dependencies": {
        "requires": ["capell-app/admin", "capell-app/core"],
        "supports": [
            "capell-app/content-sections",
            "capell-app/publishing-studio",
            "capell-app/theme-foundation"
        ],
        "conflicts": []
    },
    "providers": {
        "metadata": [
            "Capell\\StructuredContentLibrary\\Providers\\MigrationMetadataServiceProvider"
        ],
        "install": [],
        "runtime": [
            "Capell\\StructuredContentLibrary\\Providers\\StructuredContentLibraryServiceProvider"
        ],
        "admin": [
            "Capell\\StructuredContentLibrary\\Providers\\StructuredContentLibraryServiceProvider"
        ],
        "frontend": []
    },
    "contributes": [
        {
            "type": "admin-resource",
            "class": "Capell\\StructuredContentLibrary\\Manifest\\StructuredContentItemResourceContribution",
            "resourceClass": "Capell\\StructuredContentLibrary\\Filament\\Resources\\StructuredContentItems\\StructuredContentItemResource",
            "group": "StructuredContentItem"
        },
        {
            "type": "model",
            "class": "Capell\\StructuredContentLibrary\\Manifest\\StructuredContentModelsContribution"
        },
        {
            "type": "agent-capability",
            "class": "Capell\\StructuredContentLibrary\\Manifest\\StructuredContentSectionAdapterContribution",
            "capability": "content-section-adapter",
            "adapter": "content-sections",
            "actionClass": "Capell\\StructuredContentLibrary\\Actions\\BuildStructuredContentSectionsAction",
            "outputDataClass": "Capell\\StructuredContentLibrary\\Data\\StructuredContentSectionData",
            "consumerPackages": ["capell-app/content-sections"],
            "publicOutputSafety": "Returns hydrated public DTOs only; no public route, Blade query, editor marker, model id, field path, signed URL, or package identifier is emitted."
        },
        {
            "type": "agent-capability",
            "class": "Capell\\StructuredContentLibrary\\Manifest\\StructuredContentThemeAdapterContribution",
            "capability": "theme-adapter",
            "adapter": "theme",
            "actionClass": "Capell\\StructuredContentLibrary\\Actions\\BuildPublicStructuredContentItemsAction",
            "outputDataClass": "Capell\\StructuredContentLibrary\\Data\\PublicStructuredContentItemData",
            "consumerPackages": ["capell-app/theme-foundation"],
            "publicOutputSafety": "Returns hydrated public DTOs only; no public route, Blade query, editor marker, model id, field path, signed URL, or package identifier is emitted."
        },
        {
            "type": "asset",
            "class": "Capell\\StructuredContentLibrary\\Manifest\\StructuredContentAssetsContribution",
            "surface": "admin",
            "assets": ["portable-list-semantics"]
        },
        {
            "type": "scheduled-job",
            "class": "Capell\\StructuredContentLibrary\\Manifest\\StructuredContentScheduledPublicationContribution",
            "command": "structured-content-library:invalidate-due-caches",
            "frequency": "everyMinute"
        },
        {
            "type": "console-command",
            "class": "Capell\\StructuredContentLibrary\\Manifest\\StructuredContentConsoleCommandsContribution",
            "commands": ["structured-content-library:invalidate-due-caches"],
            "commandClasses": [
                "Capell\\StructuredContentLibrary\\Console\\Commands\\InvalidateDueScheduledStructuredContentCachesCommand"
            ],
            "excludedCommands": {
                "capell:structured-content-library-screenshot-fixture": "Seeds disposable screenshot data only; not an operational command."
            }
        }
    ],
    "database": {
        "migrations": true,
        "settings": false,
        "requiredTables": ["structured_content_items"]
    },
    "commands": {
        "install": null,
        "setup": null,
        "demo": null,
        "doctor": null,
        "invalidateDueCaches": "structured-content-library:invalidate-due-caches"
    },
    "settings": [],
    "actions": {
        "buildPublicStructuredContentItems": "Capell\\StructuredContentLibrary\\Actions\\BuildPublicStructuredContentItemsAction",
        "buildStructuredContentSections": "Capell\\StructuredContentLibrary\\Actions\\BuildStructuredContentSectionsAction",
        "importStructuredContentItems": "Capell\\StructuredContentLibrary\\Actions\\ImportStructuredContentItemsAction",
        "listStructuredContentItems": "Capell\\StructuredContentLibrary\\Actions\\ListStructuredContentItemsAction"
    },
    "permissions": [
        "ViewAny:StructuredContentItem",
        "View:StructuredContentItem",
        "Create:StructuredContentItem",
        "Update:StructuredContentItem",
        "Delete:StructuredContentItem"
    ],
    "capabilities": ["structured-content-library"],
    "security": {
        "riskTier": "standard",
        "publicSurface": {
            "routeNames": [],
            "auth": "none",
            "csrfExemptRoutes": [],
            "signedRoutes": [],
            "tokenizedRoutes": [],
            "webhookRoutes": [],
            "throttledRoutes": []
        },
        "sensitiveData": {
            "encryptedFields": [],
            "hashedTokenFields": [],
            "redactedOutputClasses": [],
            "plaintextJustifications": []
        },
        "publicOutput": {
            "cacheSafe": true,
            "forbidAuthoringSurface": true,
            "forbidSecrets": true,
            "forbidPublicBladeQueries": true
        },
        "externalHttpClients": {
            "requiresTimeouts": false,
            "requiresSecretRedaction": false,
            "clients": []
        },
        "adminSurface": {
            "authorization": "permissions",
            "permissions": [
                "ViewAny:StructuredContentItem",
                "View:StructuredContentItem",
                "Create:StructuredContentItem",
                "Update:StructuredContentItem",
                "Delete:StructuredContentItem"
            ]
        }
    },
    "performance": {
        "frontendRenderBudgetMs": 10,
        "adminQueryBudget": 20,
        "cacheTags": ["structured-content-library"],
        "cacheSafety": {
            "cacheable": true,
            "variesBy": ["site", "locale"],
            "sensitiveOutput": false,
            "invalidationSources": [
                {
                    "model": "Capell\\StructuredContentLibrary\\Models\\StructuredContentItem",
                    "events": ["created", "updated", "deleted"]
                }
            ],
            "queueInvalidation": true
        }
    },
    "healthChecks": [
        {
            "key": "structured-content-library.package-health",
            "label": "Structured Content Library package surfaces, providers, and install health are discoverable by Diagnostics.",
            "class": "Capell\\StructuredContentLibrary\\Health\\StructuredContentLibraryHealthCheck",
            "severity": "critical",
            "surface": "shared"
        }
    ],
    "commercial": {
        "proposedLicense": "free",
        "requestedCertification": "first-party",
        "supportPolicy": "capell-first-party",
        "privateDocsRequested": false
    },
    "marketplace": {
        "summary": "Edit testimonials, FAQs, team members, services and other repeat content once, in nine kinds of record, and publish by site and date.",
        "description": "Keep testimonials, case studies, team members, services, FAQs, resources, partners, locations and logos as records in the admin instead of retyping them on each page. Choose a site or share a record across all of them, save drafts, archive old ones and preview what is saved. A theme or section displays the published records.",
        "problem": "A team member changed job title and I am hunting for every page that still shows the old one.",
        "outcome": "Repeat content is edited once and published to one site or all of them, now or from a date.",
        "faq": [
            {
                "question": "Does a record appear on my pages as soon as it is published?",
                "answer": "Only once a developer has added it to your theme or a section. Drafts and archived records never reach the site."
            },
            {
                "question": "Can I schedule a record to go live and to leave?",
                "answer": "Yes. Publish it with a later date and it becomes available from then, and give it an end date and it leaves the site at that moment."
            },
            {
                "question": "Can I restore an earlier version of a record?",
                "answer": "Yes, when Publishing Studio is installed. Each published change is kept in the revision history."
            },
            {
                "question": "Can an editor limited to one site change shared records?",
                "answer": "No. A record belongs to one site or to all of them. Global administrators change shared records, while an editor limited to one site changes only that site's."
            }
        ],
        "screenshots": [
            {
                "path": "docs/assets/marketplace/listing-structured-content-list.png",
                "alt": "Structured Content Items table of six items with type, status, published date, sort order and Edit links",
                "caption": "See each item's type, status and publish date, and search or sort the table."
            },
            {
                "path": "docs/assets/marketplace/listing-structured-content-form.png",
                "alt": "Create Structured Content Item form showing nine selectable type cards, from case study to logo",
                "caption": "Choose one of nine types when you add an item. The type is fixed once it is saved."
            },
            {
                "path": "docs/assets/marketplace/listing-structured-content-theme-rendering.png",
                "alt": "Edit form for a testimonial with title, status, quote and attribution fields and Preview saved content and Delete buttons",
                "caption": "Each type has its own fields, and Preview saved content shows the saved values."
            },
            {
                "path": "docs/assets/marketplace/extension-card.jpg",
                "alt": "Structured Content Library listing card with a customer story testimonial beside the items table",
                "caption": "Listing artwork for the package, not a working screen."
            }
        ],
        "categories": ["foundation", "shared", "content"]
    },
    "contributionTraceability": {
        "deferredContributions": []
    }
}
