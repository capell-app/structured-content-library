{
    "manifest-version": 3,
    "name": "capell-app/structured-content-library",
    "slug": "structured-content-library",
    "displayName": "Structured Content Library",
    "kind": "package",
    "capellApiVersion": "^1.0",
    "version": "1.0.0",
    "description": "Structured Content Library stores portable reusable records for case studies, testimonials, team members, services, FAQs, resources, partners, locations, and logos.",
    "product": {
        "group": "Capell Foundation",
        "tier": "free",
        "bundle": "foundation"
    },
    "namespace": "Capell\\StructuredContentLibrary",
    "surfaces": ["admin", "shared"],
    "dependencies": {
        "requires": ["capell-app/admin", "capell-app/core"],
        "supports": [
            "capell-app/content-sections",
            "capell-app/theme-foundation"
        ],
        "conflicts": []
    },
    "providers": {
        "metadata": [],
        "install": [],
        "runtime": [
            "Capell\\StructuredContentLibrary\\Providers\\StructuredContentLibraryServiceProvider"
        ],
        "admin": [
            "Capell\\StructuredContentLibrary\\Providers\\StructuredContentLibraryServiceProvider"
        ],
        "frontend": []
    },
    "contributes": [
        {
            "type": "admin-resource",
            "class": "Capell\\StructuredContentLibrary\\Manifest\\StructuredContentItemResourceContribution",
            "resourceClass": "Capell\\StructuredContentLibrary\\Filament\\Resources\\StructuredContentItems\\StructuredContentItemResource",
            "group": "StructuredContentItem"
        },
        {
            "type": "model",
            "class": "Capell\\StructuredContentLibrary\\Manifest\\StructuredContentModelsContribution"
        },
        {
            "type": "agent-capability",
            "class": "Capell\\StructuredContentLibrary\\Manifest\\StructuredContentSectionAdapterContribution",
            "capability": "content-section-adapter",
            "adapter": "content-sections",
            "actionClass": "Capell\\StructuredContentLibrary\\Actions\\BuildStructuredContentSectionsAction",
            "outputDataClass": "Capell\\StructuredContentLibrary\\Data\\StructuredContentSectionData",
            "consumerPackages": ["capell-app/content-sections"],
            "publicOutputSafety": "Returns hydrated public DTOs only; no public route, Blade query, editor marker, model id, field path, signed URL, or package identifier is emitted."
        },
        {
            "type": "agent-capability",
            "class": "Capell\\StructuredContentLibrary\\Manifest\\StructuredContentThemeAdapterContribution",
            "capability": "theme-adapter",
            "adapter": "theme",
            "actionClass": "Capell\\StructuredContentLibrary\\Actions\\BuildPublicStructuredContentItemsAction",
            "outputDataClass": "Capell\\StructuredContentLibrary\\Data\\PublicStructuredContentItemData",
            "consumerPackages": ["capell-app/theme-foundation"],
            "publicOutputSafety": "Returns hydrated public DTOs only; no public route, Blade query, editor marker, model id, field path, signed URL, or package identifier is emitted."
        }
    ],
    "database": {
        "migrations": true,
        "settings": false,
        "requiredTables": ["structured_content_items"]
    },
    "commands": {
        "install": null,
        "setup": null,
        "demo": null,
        "doctor": null
    },
    "settings": [],
    "actions": {
        "buildPublicStructuredContentItems": "Capell\\StructuredContentLibrary\\Actions\\BuildPublicStructuredContentItemsAction",
        "buildStructuredContentSections": "Capell\\StructuredContentLibrary\\Actions\\BuildStructuredContentSectionsAction",
        "importStructuredContentItems": "Capell\\StructuredContentLibrary\\Actions\\ImportStructuredContentItemsAction",
        "listStructuredContentItems": "Capell\\StructuredContentLibrary\\Actions\\ListStructuredContentItemsAction"
    },
    "permissions": [
        "ViewAny:StructuredContentItem",
        "View:StructuredContentItem",
        "Create:StructuredContentItem",
        "Update:StructuredContentItem",
        "Delete:StructuredContentItem"
    ],
    "capabilities": ["structured-content-library"],
    "security": {
        "riskTier": "standard",
        "publicSurface": {
            "routeNames": [],
            "auth": "none",
            "csrfExemptRoutes": [],
            "signedRoutes": [],
            "tokenizedRoutes": [],
            "webhookRoutes": [],
            "throttledRoutes": []
        },
        "sensitiveData": {
            "encryptedFields": [],
            "hashedTokenFields": [],
            "redactedOutputClasses": [],
            "plaintextJustifications": []
        },
        "publicOutput": {
            "cacheSafe": true,
            "forbidAuthoringSurface": true,
            "forbidSecrets": true,
            "forbidPublicBladeQueries": true
        },
        "externalHttpClients": {
            "requiresTimeouts": false,
            "requiresSecretRedaction": false,
            "clients": []
        },
        "adminSurface": {
            "authorization": "permissions",
            "permissions": [
                "ViewAny:StructuredContentItem",
                "View:StructuredContentItem",
                "Create:StructuredContentItem",
                "Update:StructuredContentItem",
                "Delete:StructuredContentItem"
            ]
        }
    },
    "performance": {
        "frontendRenderBudgetMs": 10,
        "adminQueryBudget": 20,
        "cacheTags": ["structured-content-library"],
        "cacheSafety": {
            "cacheable": true,
            "variesBy": ["site", "locale"],
            "sensitiveOutput": false,
            "invalidationSources": [
                {
                    "model": "Capell\\StructuredContentLibrary\\Models\\StructuredContentItem",
                    "events": ["created", "updated", "deleted"]
                }
            ],
            "queueInvalidation": true
        }
    },
    "healthChecks": [
        {
            "key": "structured-content-library.package-health",
            "label": "Structured Content Library package surfaces, providers, and install health are discoverable by Diagnostics.",
            "class": "Capell\\StructuredContentLibrary\\Health\\StructuredContentLibraryHealthCheck",
            "severity": "critical",
            "surface": "shared"
        }
    ],
    "commercial": {
        "proposedLicense": "free",
        "requestedCertification": "first-party",
        "supportPolicy": "capell-first-party",
        "privateDocsRequested": false
    },
    "marketplace": {
        "summary": "A typed content library for testimonials, case studies, team members, FAQs, services and more — reusable, theme-safe records your themes render anywhere.",
        "description": "Structured Content Library stores portable reusable records for case studies, testimonials, team members, services, FAQs, resources, partners, locations, and logos.",
        "screenshots": [
            {
                "path": "docs/assets/marketplace/extension-card.jpg",
                "alt": "Structured Content Library extension preview image",
                "caption": "Structured Content Library extension preview"
            }
        ],
        "categories": ["foundation", "shared", "content"]
    },
    "contributionTraceability": {
        "deferredContributions": []
    }
}
